// ============================================================================
// Reglas de seguridad de Firestore para el Sistema de Gestión de Aceitera.
// Cópialas TAL CUAL en: Firebase Console → Firestore Database → Reglas → Publicar.
//
// Idea de fondo: el empleado REGISTRA la operación del día (vende, cobra,
// deposita, recibe producto), pero NO puede borrar ni modificar lo ya registrado.
// Eso es de administrador. Ocultar un botón en la pantalla no basta: sin estas
// reglas, cualquiera con la cuenta de empleado podría borrar una venta desde el
// navegador y descuadrar la contabilidad sin dejar rastro.
// ============================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // El empleado deja constancia; corregir o borrar es del administrador.
    function soloRegistrar() {
      return signedIn();
    }

    // ---- Perfiles de usuario ----
    // Cualquiera puede leer (para saber nombres de usuarios en formularios).
    // Un usuario puede crear SU PROPIO perfil solo como "empleado" (nunca admin).
    // Solo un admin puede crear perfiles de otros usuarios o cambiar rol/estado.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if (request.auth.uid == userId
                          && request.resource.data.role == 'empleado'
                          && request.resource.data.activo == true)
                        || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---- Solo administrador (proveedores, compras, gastos) ----
    match /suppliers/{id} {
      allow read, write: if isAdmin();
    }
    match /purchases/{id} {
      allow read, write: if isAdmin();
    }
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    // ---- Catálogos de productos ----
    // El personal lleva el control del inventario, así que administra libremente
    // marcas y categorías (son solo etiquetas para organizar los productos).
    match /categories/{id} {
      allow read, create, update, delete: if signedIn();
    }
    match /brands/{id} {
      allow read, create, update, delete: if signedIn();
    }
    // El catálogo de servicios y sus precios los define el administrador.
    match /services/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Productos ----
    // El personal recibe, cuenta y depura el catálogo: crea, actualiza y elimina.
    match /products/{id} {
      allow read, create, update, delete: if signedIn();
    }

    // ---- Clientes ----
    // El mostrador los da de alta y corrige datos (teléfono, NIT) al facturar.
    match /customers/{id} {
      allow read, create, update, delete: if signedIn();
    }

    // ---- Ventas y órdenes ----
    // El mostrador maneja las ventas de principio a fin: registra, corrige y
    // anula. Es quien atiende y quien nota el error en el momento, así que no
    // depende del dueño para arreglarlo. Anular una venta devuelve el stock y
    // deshace el movimiento de caja, por eso también necesita tocar esos dos
    // rastros (ver más abajo).
    match /sales/{id} {
      allow read, create, update, delete: if signedIn();
    }
    match /serviceOrders/{id} {
      allow read, create, update, delete: if signedIn();
    }

    // ---- Rastro de inventario y de dinero ----
    // Anular una venta tiene que poder deshacer su entrada de caja y su salida
    // de inventario; si no, quedarían huérfanas y descuadrarían el arqueo.
    match /inventoryMovements/{id} {
      allow read, create, update, delete: if signedIn();
    }
    match /cashMovements/{id} {
      allow read, create, update, delete: if signedIn();
    }
    // El arqueo del día y los depósitos sí quedan firmes: son el respaldo de
    // cuánto dinero se contó y cuánto se llevó al banco.
    match /cashClosings/{id} {
      allow read, create: if soloRegistrar();
      allow update, delete: if isAdmin();
    }
    match /deposits/{id} {
      allow read, create: if soloRegistrar();
      allow update, delete: if isAdmin();
    }

    // ---- Retiros pendientes de devolver ----
    // El empleado marca la devolución cuando repone el dinero, así que necesita
    // actualizar; borrar el registro sigue siendo del administrador.
    match /cashReturns/{id} {
      allow read, create, update: if soloRegistrar();
      allow delete: if isAdmin();
    }

    // ---- Correlativos de folios (V1, V2, …) ----
    // Se incrementan dentro de una transacción al registrar una venta u orden.
    match /counters/{id} {
      allow read, write: if signedIn();
    }
  }
}
